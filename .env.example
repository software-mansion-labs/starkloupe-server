# Scarb binary download scheduler
SCARB_GITHUB_REPO_NAME=software-mansion/scarb
SCARB_LATEST_VERSION_FILE_NAME=./binaries/scarb_latest_version.txt
SCARB_RUN_SCHEDULER_MINUTES_INTERVAL=60

LOG_LEVEL=INFO