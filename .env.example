# Copy to .env and fill in. Never commit real values.

DATABASE_URL=postgres://postgres:postgres@localhost:1234/walnut
# for the empty database, set SQLX_OFFLINE to true, later when migrations are done, it can be set to false
SQLX_OFFLINE=true
NODE_URL=

# RPC endpoints. Required - the server refuses to start without them.
# Any JSON-RPC provider works; the URL usually carries your provider API key.
STARKNET_MAINNET_RPC_URL=
STARKNET_SEPOLIA_RPC_URL=
ETHEREUM_MAINNET_RPC_URL=
ETHEREUM_SEPOLIA_RPC_URL=

# Voyager API key, used to look up verified sources and contract aliases.
# Optional - without it those lookups are skipped.
VOYAGER_API_KEY=

# Google Cloud Storage for compiled classes and Scarb binaries.
# Auth is via Application Default Credentials - set GOOGLE_APPLICATION_CREDENTIALS
# to a service-account JSON key file, or leave unset to use gcloud/workload identity.
GOOGLE_APPLICATION_CREDENTIALS=
GCS_CLASSES_BUCKET_NAME=

BINARIES_GCS_BUCKET_NAME=
# Assure it doesn't end with "/" character
BINARIES_SAVE_DIRECTORY_PATH=./binaries

# Universal Sierra Compiler binary. Installed by `make deps` into the repo root.
# Needed for simulation/replay. Leave it unset if the binary is on your PATH.
UNIVERSAL_SIERRA_COMPILER=./universal-sierra-compiler

# Scarb binary download scheduler
SCARB_GITHUB_REPO_NAME=software-mansion/scarb
SCARB_LATEST_VERSION_FILE_NAME=./binaries/scarb_latest_version.txt
SCARB_RUN_SCHEDULER_INTERVAL_MINUTES=60

DOJO_GITHUB_REPO_NAME=dojoengine/dojo
DOJO_LATEST_VERSION_FILE_NAME=./binaries/sozo_latest_version.txt
DOJO_RUN_SCHEDULER_INTERVAL_MINUTES=60

# Base URL of the web app that deep links in responses and notifications point
# to. Optional - defaults to the hosted Walnut app. Set it if you run your own
# frontend. A trailing slash is dropped.
WALNUT_APP_BASE_URL=https://app.walnut.dev

LOG_LEVEL=INFO
BUILD_CPU_LIMIT = 300 #5minutes

# Error reporting. Optional - Sentry stays off in debug builds and when unset.
SENTRY_DSN=

# Shared token for the /dashboard/data endpoint. Optional - the endpoint
# returns 401 for everyone while this is unset.
DASHBOARD_API_TOKEN=

# Notifications. All optional; each one is skipped when unset.
TELEGRAM_BOT_API_KEY=
TELEGRAM_WALNUT_NOTIFICATIONS_CHAT_ID=
GRAFANA_URL=
GRAFANA_API_KEY=
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional tuning. The code falls back to the defaults shown here if unset.
# Simulation cache
#CACHE_CAPACITY=500
#CACHE_TTL_MINUTES=2880
# External (Voyager) class cache
#EXTERNAL_CLASS_CACHE_CAPACITY=500
#EXTERNAL_CLASS_CACHE_TTL_HOURS=24
#EXTERNAL_CLASS_CACHE_FAILED_TTL_HOURS=1
# Verification build timeout, in seconds
#BUILD_TIMEOUT_SECS=120
# Background Voyager compilation retries
#MAX_BACKGROUND_COMPILATIONS=1
#VOYAGER_CONCURRENCY_LIMIT=5
